HOST=0.0.0.0
PORT=1337

# Strapi core secrets
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
JWT_SECRET=change-me-jwt-secret

# Database
DATABASE_CLIENT=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=db_storecontroller
DATABASE_USERNAME=root
DATABASE_PASSWORD=change-me-db-password
DATABASE_FILENAME=.tmp/data.db

# App auth (custom JWT + refresh token flow)
AUTH_SECRET_KEY=change-me-auth-secret-key
AUTH_REFRESH_TOKEN_SALT=change-me-refresh-token-salt
AUTH_ACCESS_EXPIRES_IN=15m
AUTH_REFRESH_EXPIRES_IN=30d
AUTH_REFRESH_EXPIRES_IN_MS=2592000000

# External services
SUITE_API=https://lab-sapi.guta.asia

# CORS for local FE dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
