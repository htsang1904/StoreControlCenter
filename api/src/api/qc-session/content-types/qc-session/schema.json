{
  "kind": "collectionType",
  "collectionName": "qc_sessions",
  "info": {
    "singularName": "qc-session",
    "pluralName": "qc-sessions",
    "displayName": "QC Session",
    "description": "QC execution session at store level"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store",
      "required": true
    },
    "form_version": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::qc-form-version.qc-form-version",
      "inversedBy": "sessions",
      "required": true
    },
    "auditor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-info.user-info"
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "submitted", "needs_fix", "closed"],
      "default": "draft",
      "required": true
    },
    "audited_at": {
      "type": "datetime",
      "required": true
    },
    "submitted_at": {
      "type": "datetime"
    },
    "result": {
      "type": "enumeration",
      "enum": ["pending", "pass", "fail"],
      "default": "pending",
      "required": true
    },
    "total_score": {
      "type": "decimal",
      "default": 0
    },
    "max_score": {
      "type": "decimal",
      "default": 0
    },
    "note": {
      "type": "text"
    },
    "items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::qc-session-item.qc-session-item",
      "mappedBy": "session"
    },
    "findings": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::qc-finding.qc-finding",
      "mappedBy": "session"
    }
  }
}
