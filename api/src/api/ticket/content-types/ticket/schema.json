{
  "kind": "collectionType",
  "collectionName": "tickets",
  "info": {
    "singularName": "ticket",
    "pluralName": "tickets",
    "displayName": "Ticket",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "ticket_code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "assigned", "in_progress", "resolved", "closed", "rejected"],
      "default": "new",
      "required": true
    },
    "requester_id": {
      "type": "integer",
      "required": true
    },
    "requester": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-info.user-info"
    },
    "handler_id": {
      "type": "integer"
    },
    "handler": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-info.user-info"
    },
    "assignees": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::user-info.user-info",
      "inversedBy": "assigned_tickets"
    },
    "store_id": {
      "type": "integer",
      "required": true
    },
    "store": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::store.store"
    },
    "responsible_department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "tickets",
      "required": true
    },
    "ticket_category_id": {
      "type": "integer"
    },
    "type": {
      "type": "string"
    },
    "start_date": {
      "type": "datetime"
    },
    "end_date": {
      "type": "datetime"
    },
    "attachments": {
      "type": "json"
    },
    "attachments_media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "ticket_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ticket-log.ticket-log",
      "mappedBy": "ticket"
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "ticket"
    },
    "qc_reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ticket-qc-review.ticket-qc-review",
      "mappedBy": "ticket"
    }
  }
}
