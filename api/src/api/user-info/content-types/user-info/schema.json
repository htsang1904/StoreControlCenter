{
  "kind": "collectionType",
  "collectionName": "user_infos",
  "info": {
    "singularName": "user-info",
    "pluralName": "user-infos",
    "displayName": "UserInfo",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "suite_token": {
      "type": "text"
    },
    "is_active": {
      "type": "boolean"
    },
    "refresh_token_hash": {
      "type": "string"
    },
    "refresh_token_expires_at": {
      "type": "datetime"
    },
    "token_version": {
      "type": "integer",
      "default": 0
    },
    "role": {
      "type": "enumeration",
      "enum": [
        "store",
        "handler",
        "qc",
        "admin"
      ],
      "default": "store",
      "required": true
    },
    "stores": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::store.store"
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "users"
    },
    "assigned_tickets": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::ticket.ticket",
      "mappedBy": "assignees"
    },
    "notifications": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::notification.notification",
      "mappedBy": "recipient"
    }
  }
}
