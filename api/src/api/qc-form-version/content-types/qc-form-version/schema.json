{
  "kind": "collectionType",
  "collectionName": "qc_form_versions",
  "info": {
    "singularName": "qc-form-version",
    "pluralName": "qc-form-versions",
    "displayName": "QC Form Version",
    "description": "Immutable version of a QC form"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "form": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::qc-form.qc-form",
      "inversedBy": "versions",
      "required": true
    },
    "version_no": {
      "type": "string",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "published", "archived"],
      "default": "draft",
      "required": true
    },
    "pass_rule": {
      "type": "json"
    },
    "effective_from": {
      "type": "datetime"
    },
    "effective_to": {
      "type": "datetime"
    },
    "form_criteria": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::qc-form-criterion.qc-form-criterion",
      "mappedBy": "form_version"
    },
    "sessions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::qc-session.qc-session",
      "mappedBy": "form_version"
    }
  }
}
